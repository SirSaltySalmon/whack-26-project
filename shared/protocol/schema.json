{
  "$defs": {
    "AvatarState": {
      "properties": {
        "state": {
          "enum": [
            "idle",
            "listening",
            "talking",
            "reacting"
          ],
          "title": "State",
          "type": "string"
        },
        "type": {
          "const": "avatar.state",
          "default": "avatar.state",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "AvatarState",
      "type": "object"
    },
    "BrainDescription": {
      "description": "Printed by `python -m brain --describe`, before anything starts. Never holds key values.",
      "properties": {
        "game_process": {
          "title": "Game Process",
          "type": "string"
        },
        "game_title": {
          "title": "Game Title",
          "type": "string"
        },
        "keys_set": {
          "additionalProperties": {
            "type": "boolean"
          },
          "title": "Keys Set",
          "type": "object"
        },
        "personalities": {
          "items": {
            "type": "string"
          },
          "title": "Personalities",
          "type": "array"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "integer"
        },
        "voices": {
          "items": {
            "$ref": "#/$defs/VoiceOption"
          },
          "title": "Voices",
          "type": "array"
        }
      },
      "required": [
        "protocol_version",
        "personalities",
        "voices",
        "keys_set",
        "game_title",
        "game_process"
      ],
      "title": "BrainDescription",
      "type": "object"
    },
    "BrainStatus": {
      "description": "Which parts of the partner are running, so the Control Center can show what's on.",
      "properties": {
        "game_title": {
          "title": "Game Title",
          "type": "string"
        },
        "listening": {
          "title": "Listening",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "live",
            "replay"
          ],
          "title": "Mode",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "speaking": {
          "title": "Speaking",
          "type": "boolean"
        },
        "talking": {
          "title": "Talking",
          "type": "boolean"
        },
        "tools": {
          "title": "Tools",
          "type": "boolean"
        },
        "type": {
          "const": "brain.status",
          "default": "brain.status",
          "title": "Type",
          "type": "string"
        },
        "watching": {
          "title": "Watching",
          "type": "boolean"
        },
        "wiki_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wiki Url"
        }
      },
      "required": [
        "mode",
        "game_title",
        "watching",
        "listening",
        "speaking",
        "talking",
        "tools"
      ],
      "title": "BrainStatus",
      "type": "object"
    },
    "CardClose": {
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "type": {
          "const": "card.close",
          "default": "card.close",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "card_id"
      ],
      "title": "CardClose",
      "type": "object"
    },
    "CardClosed": {
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "type": {
          "const": "card.closed",
          "default": "card.closed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "card_id"
      ],
      "title": "CardClosed",
      "type": "object"
    },
    "CardNavigated": {
      "description": "The wiki window's page changed. The URL and title come from a website: treat them as data.",
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "card.navigated",
          "default": "card.navigated",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "url"
      ],
      "title": "CardNavigated",
      "type": "object"
    },
    "CardShow": {
      "description": "Body is sanitized plain text, never raw HTML.\n\nSet page_url to show the real site in the sandboxed wiki window, with body as the text shown if\nit can't load. Send it only for lookups the player asked for, so the page can't change while\nthey're reading. The overlay has one wiki window, so a new page_url reuses it.",
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "page_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Url"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "type": {
          "const": "card.show",
          "default": "card.show",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "card_id",
        "title",
        "body"
      ],
      "title": "CardShow",
      "type": "object"
    },
    "CardUpdate": {
      "properties": {
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "type": {
          "const": "card.update",
          "default": "card.update",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "card_id"
      ],
      "title": "CardUpdate",
      "type": "object"
    },
    "ContextPreview": {
      "description": "Asks for the exact context the talker would get for this query. For a game other than the\none being played, that's the context the next session of it would start with.",
      "properties": {
        "game": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Game"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "text": {
          "maxLength": 500,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "memory.context_preview",
          "default": "memory.context_preview",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "text"
      ],
      "title": "ContextPreview",
      "type": "object"
    },
    "ControlError": {
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "type": {
          "const": "control.error",
          "default": "control.error",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "ControlError",
      "type": "object"
    },
    "ControlHello": {
      "properties": {
        "protocol_version": {
          "title": "Protocol Version",
          "type": "integer"
        },
        "type": {
          "const": "control.hello",
          "default": "control.hello",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocol_version"
      ],
      "title": "ControlHello",
      "type": "object"
    },
    "ControlShutdown": {
      "description": "Stop the brain cleanly, so the session is closed and its note written.",
      "properties": {
        "type": {
          "const": "control.shutdown",
          "default": "control.shutdown",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ControlShutdown",
      "type": "object"
    },
    "DangerState": {
      "description": "How much trouble the player is in, so the overlay can show it without covering the game.\nSent when the level changes, and again when the overlay connects.",
      "properties": {
        "level": {
          "enum": [
            "none",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        },
        "type": {
          "const": "danger.state",
          "default": "danger.state",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "title": "DangerState",
      "type": "object"
    },
    "DebugRegion": {
      "properties": {
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Display"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        },
        "status": {
          "enum": [
            "ok",
            "masked",
            "unreadable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "rect",
        "status"
      ],
      "title": "DebugRegion",
      "type": "object"
    },
    "DebugRegions": {
      "description": "A debug view of where each HUD region was found and what its reader reads.\n\nAlways the full current set, so an empty list clears the view. Send it about twice a second\nwhile debugging: the overlay hides the view when messages stop.",
      "properties": {
        "regions": {
          "items": {
            "$ref": "#/$defs/DebugRegion"
          },
          "title": "Regions",
          "type": "array"
        },
        "type": {
          "const": "debug.regions",
          "default": "debug.regions",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "regions"
      ],
      "title": "DebugRegions",
      "type": "object"
    },
    "ElementRect": {
      "properties": {
        "element_id": {
          "title": "Element Id",
          "type": "string"
        },
        "rect": {
          "$ref": "#/$defs/Rect"
        }
      },
      "required": [
        "element_id",
        "rect"
      ],
      "title": "ElementRect",
      "type": "object"
    },
    "FactView": {
      "properties": {
        "attribute": {
          "title": "Attribute",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "source": {
          "enum": [
            "player",
            "observed",
            "wiki"
          ],
          "title": "Source",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "tentative": {
          "title": "Tentative",
          "type": "boolean"
        },
        "valid_from": {
          "title": "Valid From",
          "type": "number"
        },
        "valid_to": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid To"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "id",
        "subject",
        "attribute",
        "value",
        "source",
        "confidence",
        "tentative",
        "valid_from"
      ],
      "title": "FactView",
      "type": "object"
    },
    "GameView": {
      "description": "One game memory has something filed under.",
      "properties": {
        "facts": {
          "title": "Facts",
          "type": "integer"
        },
        "last_played": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Played"
        },
        "questions": {
          "title": "Questions",
          "type": "integer"
        },
        "sessions": {
          "title": "Sessions",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "facts",
        "questions",
        "sessions"
      ],
      "title": "GameView",
      "type": "object"
    },
    "MemoryContext": {
      "properties": {
        "context": {
          "title": "Context",
          "type": "string"
        },
        "elapsed_ms": {
          "title": "Elapsed Ms",
          "type": "number"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "memory.context",
          "default": "memory.context",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "context",
        "elapsed_ms"
      ],
      "title": "MemoryContext",
      "type": "object"
    },
    "MemoryGames": {
      "properties": {
        "current": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "games": {
          "items": {
            "$ref": "#/$defs/GameView"
          },
          "title": "Games",
          "type": "array"
        },
        "live": {
          "title": "Live",
          "type": "boolean"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "memory.games",
          "default": "memory.games",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "games",
        "live"
      ],
      "title": "MemoryGames",
      "type": "object"
    },
    "MemoryListGames": {
      "description": "Asks which games memory holds anything for.",
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "memory.list_games",
          "default": "memory.list_games",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "MemoryListGames",
      "type": "object"
    },
    "MemoryQuery": {
      "description": "Empty text lists the newest facts instead of searching.",
      "properties": {
        "game": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Game"
        },
        "include_history": {
          "default": false,
          "title": "Include History",
          "type": "boolean"
        },
        "limit": {
          "default": 50,
          "maximum": 200,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 500,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "memory.query",
          "default": "memory.query",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id"
      ],
      "title": "MemoryQuery",
      "type": "object"
    },
    "MemoryResults": {
      "properties": {
        "elapsed_ms": {
          "title": "Elapsed Ms",
          "type": "number"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/FactView"
          },
          "title": "Facts",
          "type": "array"
        },
        "notes": {
          "items": {
            "$ref": "#/$defs/NoteView"
          },
          "title": "Notes",
          "type": "array"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/QuestionView"
          },
          "title": "Questions",
          "type": "array"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "memory.results",
          "default": "memory.results",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "facts",
        "questions",
        "notes",
        "elapsed_ms"
      ],
      "title": "MemoryResults",
      "type": "object"
    },
    "MemoryToast": {
      "properties": {
        "source": {
          "enum": [
            "player",
            "observed",
            "wiki"
          ],
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "toast.memory",
          "default": "toast.memory",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text",
        "source"
      ],
      "title": "MemoryToast",
      "type": "object"
    },
    "NoteView": {
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "rolling",
            "recap"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "body",
        "created_at"
      ],
      "title": "NoteView",
      "type": "object"
    },
    "OverlayReady": {
      "properties": {
        "display_scale": {
          "title": "Display Scale",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "integer"
        },
        "type": {
          "const": "overlay.ready",
          "default": "overlay.ready",
          "title": "Type",
          "type": "string"
        },
        "width": {
          "title": "Width",
          "type": "number"
        }
      },
      "required": [
        "protocol_version",
        "display_scale",
        "width",
        "height"
      ],
      "title": "OverlayReady",
      "type": "object"
    },
    "OverlayRects": {
      "description": "Every visible element. The brain masks these so the AI can't read its own UI.",
      "properties": {
        "rects": {
          "items": {
            "$ref": "#/$defs/ElementRect"
          },
          "title": "Rects",
          "type": "array"
        },
        "type": {
          "const": "overlay.rects",
          "default": "overlay.rects",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "rects"
      ],
      "title": "OverlayRects",
      "type": "object"
    },
    "Pacing": {
      "description": "How often the partner may speak up unasked, in seconds. The director's rules apply it.\n\nA player setting rather than config, so it can be tuned while playing.",
      "properties": {
        "advice_first_s": {
          "default": 45.0,
          "minimum": 0,
          "title": "Advice First S",
          "type": "number"
        },
        "advice_gap_s": {
          "default": 90.0,
          "minimum": 0,
          "title": "Advice Gap S",
          "type": "number"
        },
        "advice_quiet_s": {
          "default": 10.0,
          "minimum": 0,
          "title": "Advice Quiet S",
          "type": "number"
        },
        "event_gap_s": {
          "default": 8.0,
          "minimum": 0,
          "title": "Event Gap S",
          "type": "number"
        },
        "question_gap_s": {
          "default": 45.0,
          "minimum": 0,
          "title": "Question Gap S",
          "type": "number"
        },
        "question_quiet_s": {
          "default": 0.0,
          "minimum": 0,
          "title": "Question Quiet S",
          "type": "number"
        }
      },
      "title": "Pacing",
      "type": "object"
    },
    "PageContent": {
      "description": "The wiki window's rendered text, in reply to page.read. Every field comes from a website, so\ntreat all of it as untrusted data.",
      "properties": {
        "card_id": {
          "title": "Card Id",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "text": {
          "maxLength": 200000,
          "title": "Text",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "type": {
          "const": "page.content",
          "default": "page.content",
          "title": "Type",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "visible_text": {
          "maxLength": 4000,
          "title": "Visible Text",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "card_id",
        "url",
        "text",
        "visible_text"
      ],
      "title": "PageContent",
      "type": "object"
    },
    "PageRead": {
      "description": "Asks for the wiki window's rendered text. The brain sends it only for its own wiki's host.",
      "properties": {
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "type": {
          "const": "page.read",
          "default": "page.read",
          "title": "Type",
          "type": "string"
