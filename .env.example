# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Haiku reports on what's on screen. Paid; without it the brain doesn't watch the game.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs voice library. Without it the brain runs subtitles only.
ELEVENLABS_VOICE_ID=

# The game's process name, such as Terraria. Leave it unset to pick the game's window in the
# terminal at startup; the pick is remembered in data/games.json.
# GAME_PROCESS=

# Optional
EXA_API_KEY=
CARTESIA_API_KEY=

# Voices offered in the overlay's settings (optional). Without this, the settings panel hides voice.
# Both are ElevenLabs default voices, so any account can use them.
VOICE_OPTIONS=[{"name":"Jessica (female)","id":"cgSgspJ2msm6clMCkdW9"},{"name":"Brian (male)","id":"nPczCjzI2devNBz1zQrb"}]

# Voice tuning (optional). Keyterms are a JSON list, e.g. ["Eye of Cthulhu","Terraprisma"]
STT_KEYTERMS=[]
# MIC_DEVICE_INDEX=0
# SPEAKER_DEVICE_INDEX=1

# No headphones? Mute the mic while the partner talks so it can't interrupt itself (no barge-in).
VOICE_HALF_DUPLEX=false

# The game's title, which memory, the learned profile and the wiki search are filed under. Leave it
# unset and the deep model names the game from its window once per app. Don't set it blank: a
# blank value is used as the title.
# GAME_TITLE=
