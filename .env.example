# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Haiku reports on what's on screen. Paid; without it the brain doesn't watch the game.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs voice library. Without it the brain runs subtitles only.
ELEVENLABS_VOICE_ID=

# The game's process name. Live capture stays off until this is set.
GAME_PROCESS=Terraria

# Optional
EXA_API_KEY=
CARTESIA_API_KEY=

# Voice tuning (optional). Keyterms are a JSON list, e.g. ["Eye of Cthulhu","Terraprisma"]
STT_KEYTERMS=[]
# MIC_DEVICE_INDEX=0
# SPEAKER_DEVICE_INDEX=1

# No headphones? Mute the mic while the partner talks so it can't interrupt itself (no barge-in).
VOICE_HALF_DUPLEX=false

# The game being played. Memory and the learned profile are filed under this name, so change
# it for each game. Don't leave it blank: a blank value is used as the title.
GAME_TITLE=Terraria
